rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Existing authenticated collections ──────────────────────────────────
    match /cases/{caseId} {
      allow read, write: if request.auth != null;
    }

    // ── SemanticBridgeNodes ─────────────────────────────────────────────────
    // Auth-gated read/write. Firestore-level PII field guard.
    match /semanticBridgeNodes/{nodeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && !('patientName'  in request.resource.data)
        && !('userId'       in request.resource.data)
        && !('personalId'   in request.resource.data)
        && !('birthNumber'  in request.resource.data);
    }

    // ── CausalChronometerNodes ──────────────────────────────────────────────
    match /causalChronometerNodes/{nodeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && !('patientName'  in request.resource.data)
        && !('userId'       in request.resource.data)
        && !('personalId'   in request.resource.data)
        && !('birthNumber'  in request.resource.data);
    }

    // ── TrainingPool ────────────────────────────────────────────────────────
    // Write-only for authenticated users.
    // Read/update/delete: backend-only via Firebase Admin SDK.
    match /trainingPool/{entryId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ── Livemap public projection ───────────────────────────────────────────
    // Sanitized summaries only. Written exclusively by backend Admin SDK.
    match /livemap/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
