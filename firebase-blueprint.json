{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "User's profile picture URL." },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User's role in the system." }
      },
      "required": ["uid", "email"]
    },
    "Audit": {
      "title": "Forensic Audit",
      "description": "An encrypted forensic audit analysis record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the audit." },
        "uid": { "type": "string", "description": "Owner's user ID." },
        "encryptedData": { "type": "string", "description": "AES-256-GCM encrypted JSON data." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of audit creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of last update." }
      },
      "required": ["id", "uid", "encryptedData", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/audits/{auditId}": {
      "schema": "Audit",
      "description": "Forensic audit analysis records."
    }
  }
}
