import React, { useState, useEffect } from 'react';
import { ControlRoomState, NetworkNode, ChangelogEntry } from '../types';
import { Activity, Database, Cpu, Terminal, Share2, ShieldCheck, Zap, Layers } from 'lucide-react';
import { motion, AnimatePresence } from 'motion/react';

interface ControlRoomProps {
  state: ControlRoomState;
}

const ControlRoom: React.FC<ControlRoomProps> = ({ state }) => {
  const [activeNode, setActiveNode] = useState<string | null>(null);

  return (
    <div className="space-y-6 p-6 bg-slate-950 border border-slate-800 rounded-xl font-mono text-slate-300">
      {/* HEADER */}
      <div className="flex items-center justify-between border-b border-slate-800 pb-4">
        <div className="flex items-center gap-3">
          <div className="p-2 bg-purple-500/10 rounded-lg">
            <Terminal className="w-6 h-6 text-purple-500" />
          </div>
          <div>
            <h2 className="text-lg font-bold text-white uppercase tracking-tighter">Control Room: Visual Database Environment</h2>
            <p className="text-[10px] text-slate-500">SOURCE: CoC(AIDEEPMIND Forenzica) v9.3</p>
          </div>
        </div>
        <div className="flex items-center gap-4">
          <div className="flex items-center gap-2">
            <div className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
            <span className="text-[10px] text-emerald-500 font-bold">SYSTEM_ONLINE</span>
          </div>
          <div className="px-3 py-1 bg-slate-900 border border-slate-800 rounded text-[10px] text-slate-400">
            CYPHER_METHOD: AES-256-GCM-META
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* NETWORK VISUALIZATION */}
        <div className="lg:col-span-2 space-y-4">
          <div className="bg-slate-900/50 border border-slate-800 p-4 rounded-lg relative min-h-[400px] overflow-hidden">
            <h3 className="text-xs font-bold text-purple-400 mb-6 flex items-center gap-2">
              <Share2 className="w-3 h-3" /> NETWORK-DATABASE-NETWORK TOPOLOGY
            </h3>
            
            {/* Simulated Network Graph */}
            <div className="relative w-full h-full flex items-center justify-center">
              {state.nodes.map((node, idx) => {
                const angle = (idx / state.nodes.length) * 2 * Math.PI;
                const radius = 120;
                const x = Math.cos(angle) * radius;
                const y = Math.sin(angle) * radius;

                return (
                  <motion.div
                    key={node.id}
                    initial={{ opacity: 0, scale: 0 }}
                    animate={{ opacity: 1, scale: 1 }}
                    transition={{ delay: idx * 0.1 }}
                    style={{ transform: `translate(${x}px, ${y}px)` }}
                    className={`absolute p-3 rounded-lg border cursor-pointer transition-all z-10 ${
                      activeNode === node.id 
                        ? 'bg-purple-500/20 border-purple-500 shadow-lg shadow-purple-500/20 scale-110' 
                        : 'bg-slate-950 border-slate-800 hover:border-slate-600'
                    }`}
                    onClick={() => setActiveNode(node.id)}
                  >
                    <div className="flex flex-col items-center gap-1">
                      {node.type === 'INSTRUCTION' && <Zap className="w-4 h-4 text-amber-400" />}
                      {node.type === 'DATABASE' && <Database className="w-4 h-4 text-cyan-400" />}
                      {node.type === 'NLP_CORE' && <Cpu className="w-4 h-4 text-purple-400" />}
                      <span className="text-[9px] font-bold uppercase tracking-tighter">{node.label}</span>
                      <span className={`text-[7px] px-1 rounded ${
                        node.status === 'ACTIVE' ? 'bg-emerald-500/10 text-emerald-500' : 'bg-slate-800 text-slate-500'
                      }`}>
                        {node.status}
                      </span>
                    </div>
                  </motion.div>
                );
              })}

              {/* SVG Connections */}
              <svg className="absolute inset-0 w-full h-full pointer-events-none opacity-20">
                {state.nodes.map((node, idx) => {
                  const angle = (idx / state.nodes.length) * 2 * Math.PI;
                  const radius = 120;
                  const x1 = 200 + Math.cos(angle) * radius;
                  const y1 = 200 + Math.sin(angle) * radius;

                  return node.connections.map(connId => {
                    const targetIdx = state.nodes.findIndex(n => n.id === connId);
                    if (targetIdx === -1) return null;
                    const targetAngle = (targetIdx / state.nodes.length) * 2 * Math.PI;
                    const x2 = 200 + Math.cos(targetAngle) * radius;
                    const y2 = 200 + Math.sin(targetAngle) * radius;

                    return (
                      <line 
                        key={`${node.id}-${connId}`}
                        x1="50%" y1="50%" 
                        x2={`${50 + (Math.cos(angle) * 30)}%`} 
                        y2={`${50 + (Math.sin(angle) * 30)}%`}
                        stroke="currentColor" 
                        className="text-purple-500"
                        strokeWidth="1"
                      />
                    );
                  });
                })}
              </svg>
            </div>

            {/* Node Info Overlay */}
            <AnimatePresence>
              {activeNode && (
                <motion.div
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0, y: 20 }}
                  className="absolute bottom-4 left-4 right-4 bg-slate-950/90 border border-purple-500/50 p-4 rounded-lg backdrop-blur-md z-20"
                >
                  <div className="flex justify-between items-start">
                    <div>
                      <h4 className="text-xs font-bold text-white mb-1">
                        NODE_DETAILS: {state.nodes.find(n => n.id === activeNode)?.label}
                      </h4>
                      <p className="text-[10px] text-slate-400 italic">
                        Deduction Reason: {state.systemAnalysis}
                      </p>
                    </div>
                    <button onClick={() => setActiveNode(null)} className="text-slate-500 hover:text-white">×</button>
                  </div>
                </motion.div>
              )}
            </AnimatePresence>
          </div>
        </div>

        {/* STRUCTURAL CHANGELOG */}
        <div className="space-y-4">
          <div className="bg-slate-900/50 border border-slate-800 p-4 rounded-lg h-full flex flex-col">
            <h3 className="text-xs font-bold text-slate-500 mb-4 flex items-center gap-2">
              <Layers className="w-3 h-3" /> STRUCTURAL CHANGELOG SYSTEM
            </h3>
            
            <div className="flex-1 overflow-y-auto space-y-3 pr-2 scrollbar-hide">
              {state.changelog.map((entry, idx) => (
                <div key={idx} className="p-3 bg-black border border-slate-800 rounded-lg space-y-2 hover:border-purple-500/30 transition-colors">
                  <div className="flex justify-between items-center">
                    <span className="text-[8px] text-slate-600">{entry.timestamp}</span>
                    <span className={`text-[8px] px-1 rounded font-bold ${
                      entry.changeType === 'STRUCTURAL' ? 'bg-cyan-500/10 text-cyan-500' :
                      entry.changeType === 'METACODE' ? 'bg-purple-500/10 text-purple-400' :
                      'bg-amber-500/10 text-amber-500'
                    }`}>
                      {entry.changeType}
                    </span>
                  </div>
                  <div className="text-[10px] font-bold text-slate-300">{entry.module}</div>
                  <div className="text-[9px] text-slate-500 leading-tight">
                    <span className="text-purple-900">REASON:</span> {entry.deductionReason}
                  </div>
                  <div className="text-[9px] text-slate-400 bg-slate-900/50 p-2 rounded italic">
                    {entry.outputAnalysed}
                  </div>
                  <div className="text-[8px] text-slate-600 font-mono">
                    CYPHER: {entry.cypheringMethod}
                  </div>
                </div>
              ))}
            </div>

            <div className="mt-4 pt-4 border-t border-slate-800">
              <div className="flex items-center gap-2 text-[10px] text-emerald-500 font-bold">
                <ShieldCheck className="w-3 h-3" /> ALL-REASONED COREBASE VALIDATED
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default ControlRoom;
